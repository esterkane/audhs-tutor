APP_ENV=dev
DATABASE_URL=sqlite+aiosqlite:///./data/dev.db
OLLAMA_HOST=http://localhost:11434
# Retain local chat models between study turns; 300 restores five minutes, 0 unloads.
OLLAMA_KEEP_ALIVE_S=1800
# Load local tutor weights after starting a session; no answer generation.
# Also applies when explicitly continuing a saved session.
OLLAMA_PREPARE_ON_SESSION_START=true
ANTHROPIC_API_KEY=
DAILY_BUDGET_USD=1.50
ROUTING_PROFILE=default          # models_ai/routing.py profile name
EMBED_MODEL=nomic-embed-text
WHISPER_MODEL=mlx-community/whisper-large-v3-turbo
KOKORO_URL=http://localhost:8880
QDRANT_URL=http://localhost:6333
MODELS_DIR=./data/models
HF_TOKEN=
TRANSCRIPT_CACHE_DIR=./data/transcripts
VISION_CACHE_DIR=./data/vision
STT_LANGUAGE=
VOICE_DIR=./data/voice

# optional services
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Stage 3 knowledge system
RETRIEVAL_MAX_PER_DOCUMENT=3
QUARANTINE_BELOW_TRUST=2
INGEST_ROOTS=~

TRANSCRIPT_CACHE_DIR=./data/transcripts
STT_LANGUAGE=
VOICE_DIR=./data/voice

# Explicit Ollama runtime context; bounded by each model's registry context length.
OLLAMA_CONTEXT_TOKENS=16384

# Storage root for private knowledge-authoring uploads (originals stay under ignored data).
KNOWLEDGE_AUTHORING_ROOT=./data

# Optional registry-id -> matching local tokenizer JSON. No automatic downloads.
# Plain chat reserves a smaller context only when the complete input/output fit.
OLLAMA_CONTEXT_TOKENIZERS={}

# Optional explicit per-registry generation controls. Empty preserves existing task defaults.
# Named reasoning levels must be advertised by that local model via /api/show.
OLLAMA_INFERENCE_OPTIONS={}

# Optional local Supabase learning project; never commit actual connection credentials.
SUPABASE_PROJECT_DB_URL=
SUPABASE_PROJECT_USER_ID=
SUPABASE_PROJECT_URL=http://127.0.0.1:54321
